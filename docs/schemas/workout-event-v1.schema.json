{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptfit.local/schema/workout-event-v1.json",
  "title": "WorkoutEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "exercise_id", "variant_id", "side", "start_timestamp_ms", "end_timestamp_ms", "count_delta", "event_confidence", "tracking_confidence", "abstention", "reason_code", "model_version", "feature_schema_version", "decoder_version"],
  "properties": {
    "schema_version": {"const": "workout-event.v1"},
    "session_id": {"type": "string"},
    "exercise_id": {"type": "string"},
    "variant_id": {"type": "string"},
    "side": {"type": "string", "enum": ["left", "right", "bilateral", "alternating", "unknown"]},
    "start_timestamp_ms": {"type": "integer", "minimum": 0},
    "end_timestamp_ms": {"type": "integer", "minimum": 0},
    "count_delta": {"type": "integer", "minimum": 0},
    "event_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "tracking_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "abstention": {"type": "boolean"},
    "reason_code": {"type": "string"},
    "model_version": {"type": "string"},
    "feature_schema_version": {"type": "string"},
    "decoder_version": {"type": "string"}
  }
}
